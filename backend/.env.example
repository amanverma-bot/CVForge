# CVForge Environment Configuration
# Copy to .env and edit values before running

PORT=5001
NODE_ENV=development
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
MONGO_URI=
# First entry is the post-OAuth redirect target; all entries are CORS origins.
# For OAuth, the SPA and API must share one site/origin (or use the Vite proxy).
FRONTEND_URL=http://localhost:5173
# OAuth (optional — configure one or both providers).
# Register the exact callback URL in each provider console. Real provider
# logins require a publicly reachable HTTPS origin; localhost HTTP is allowed
# for local development. Never commit real client secrets.
# In production, FRONTEND_URL and every configured callback must be HTTPS and
# share the exact same origin (e.g. https://HOST), and the callback path must be
# /api/auth/{provider}/callback. Set NODE_ENV=development for local HTTP OAuth.
# Google example (local):  http://localhost:5001/api/auth/google/callback
# Google example (ngrok):  https://YOUR-SUBDOMAIN.ngrok-free.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# GitHub example (local):  http://localhost:5001/api/auth/github/callback
# GitHub example (ngrok):  https://YOUR-SUBDOMAIN.ngrok-free.app/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Firebase Google sign-in (optional). Both values are required together.
# FIREBASE_PROJECT_ID must be cvforge-ca97c. The Admin service-account JSON
# must live at an absolute path OUTSIDE this repository. Create the parent
# directory with mode 700 and chmod 600 the JSON file. It must never be committed. The server starts without Firebase; the endpoint returns
# 503 until both values are set. Leave both blank to disable Firebase sign-in.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Free local fallback (Ollama/LM Studio/llama.cpp OpenAI-compatible endpoint)
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LOCAL_LLM_TIMEOUT_MS=120000
LLM_HEALTH_TIMEOUT_MS=30000
LLM_HEALTH_CACHE_MS=30000
LOG_LEVEL=debug
TRUST_PROXY=loopback
ALLOW_TUNNEL_ORIGINS=false
FORCE_HTTPS=false
RATE_LIMIT_ENABLED=true