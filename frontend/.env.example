# Firebase Web App configuration for Google sign-in.
# These VITE_* values are public browser configuration, not secrets.
# Copy to frontend/.env.local and fill from Firebase Console > Project settings.
# Without them the Google button falls back to the legacy backend OAuth route
# (only when GOOGLE_CLIENT_ID/SECRET are configured).
# Vite substitutes these values at build time; they are not read from process.env at runtime.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cvforge-ca97c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cvforge-ca97c
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
